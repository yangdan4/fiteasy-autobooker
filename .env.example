# ---- FitEasy credentials (used by the bot at runtime to log in) ----
FITEASY_EMAIL=you@example.com
FITEASY_PASSWORD=your-password

# ---- Target ----
FITEASY_BASE_URL=https://join.fiteasy.jp
FITEASY_SHOP_SLUG=sauna60-room
FITEASY_SHOP_ID=230

# ---- Dashboard access (protect the public link!) ----
# Anyone with this token can change your booking prefs. Set something long.
DASHBOARD_TOKEN=change-me-to-a-long-random-string

# ---- Initial preference defaults (editable later in the dashboard) ----
DEFAULT_LATEST_TIME=18:00
DEFAULT_EARLIEST_TIME=00:00
DEFAULT_DRY_RUN=true
DEFAULT_ENABLED=true

# ---- Storage / misc ----
DB_PATH=data/fiteasy.db
TZ=Asia/Tokyo

# ---- Advanced: override schedule-page parsing if the heuristics miss ----
# Leave blank unless the dashboard shows 0 detected slots and you've looked at
# the /api/debug/last-html dump. CSS selectors.
SLOT_FORM_SELECTOR=
CANCEL_FORM_SELECTOR=
